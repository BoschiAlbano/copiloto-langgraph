{
  "name": "copiloto-langgraph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "chat": "tsx src/cli/chat.ts",
    "test": "vitest run && vitest run --config vitest.writes.config.ts",
    "test:writes": "vitest run --config vitest.writes.config.ts",
    "typecheck": "tsc --noEmit",
    "threads": "tsx src/cli/threads.ts",
    "memory": "tsx src/cli/memory.ts",
    "bench": "tsx src/cli/bench.ts",
    "eval:router": "tsx src/cli/eval-router.ts",
    "eval:actions": "tsx src/cli/eval-actions.ts",
    "eval:report": "tsx src/cli/eval-report.ts",
    "eval:plan": "tsx src/cli/eval-plan.ts",
    "eval:memory": "tsx src/cli/eval-memory.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:roles": "tsx src/db/roles.ts",
    "db:checkpoints": "tsx src/db/checkpoints.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts"
  },
  "dependencies": {
    "@langchain/anthropic": "1.6.0",
    "@langchain/core": "1.3.0",
    "@langchain/langgraph": "1.5.3",
    "@langchain/langgraph-checkpoint-postgres": "1.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.20.0",
    "prisma": "7.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
