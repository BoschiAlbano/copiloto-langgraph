# Clave de la API de Claude (console.anthropic.com → API Keys). Es lo único que no se puede inventar.
ANTHROPIC_API_KEY=

# Modelo de cada rol (se cambia sin tocar código)
MODEL_AGENT=claude-haiku-5-5
MODEL_ROUTER=claude-haiku-5-5
MODEL_REPORT=claude-haiku-5-5

# --- La base -------------------------------------------------------------------------------------------------------
# Forma 1 (la de un clon limpio): el Postgres 17 del docker-compose.yml del repositorio, en el puerto 54329.
# `npm run setup` lo levanta, crea los roles con las contraseñas de estas URL y carga los datos de prueba.
# Cambiá las contraseñas por las tuyas (cualquiera sirve: la base es solo de esta máquina).
POSTGRES_PASSWORD=cambiame-dueno
# READ: rol copilot_reader (solo lectura), lo usan las herramientas del agente.
DATABASE_URL_READ=postgresql://copilot_reader:cambiame-lectura@localhost:54329/postgres
# CHECKPOINTS: rol copilot_checkpointer (hilos, memorias, trazas y evaluaciones).
DATABASE_URL_CHECKPOINTS=postgresql://copilot_checkpointer:cambiame-hilos@localhost:54329/postgres
# ACTIONS: rol copilot_actions (escribe, con permisos mínimos, solo tras una aprobación).
DATABASE_URL_ACTIONS=postgresql://copilot_actions:cambiame-acciones@localhost:54329/postgres
# WRITE: el dueño de la base (migraciones, seed, tests, respaldos). La aplicación nunca la usa.
DATABASE_URL_WRITE=postgresql://postgres:cambiame-dueno@localhost:54329/postgres

# Forma 2: un Supabase local, por el pooler en modo sesión (puerto 5432). El usuario lleva el tenant del pooler:
# <rol>.<POOLER_TENANT_ID> (sale del .env de tu Supabase). Con esta forma, POSTGRES_PASSWORD no se usa.
# DATABASE_URL_READ=postgresql://copilot_reader.<tenant>:<password>@localhost:5432/postgres
# DATABASE_URL_CHECKPOINTS=postgresql://copilot_checkpointer.<tenant>:<password>@localhost:5432/postgres
# DATABASE_URL_ACTIONS=postgresql://copilot_actions.<tenant>:<password>@localhost:5432/postgres
# DATABASE_URL_WRITE=postgresql://postgres.<tenant>:<password>@localhost:5432/postgres
# BACKUP_CONTAINER=supabase-db   # el contenedor de la base, para db:backup y db:restore

# --- Operación (fase 12; todas opcionales) -------------------------------------------------------------------------
# DAILY_BUDGET_USD=1        # tope de gasto por día en la API de Claude (0 lo desactiva)
# MODEL_TIMEOUT_MS=60000    # límite de una llamada al modelo
# TURN_TIMEOUT_MS=180000    # límite de un turno entero (si se pasa, queda a medias y se puede continuar)
# TRACE_RETENTION_DAYS=30   # cuántos días se guardan las trazas
# LOG_RETENTION_DAYS=14     # cuántos días se guardan los registros de logs/
