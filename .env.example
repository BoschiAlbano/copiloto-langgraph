# Modelo de cada rol (se cambia sin tocar código)
ANTHROPIC_API_KEY=
MODEL_AGENT=claude-haiku-5-5

# Cadenas de conexión a Postgres (Supabase local, por el pooler en modo sesión).
# El usuario lleva el tenant del pooler: postgres.<POOLER_TENANT_ID>
DATABASE_URL_READ=postgresql://postgres.<tenant>:<password>@localhost:5432/postgres
DATABASE_URL_WRITE=postgresql://postgres.<tenant>:<password>@localhost:5432/postgres
